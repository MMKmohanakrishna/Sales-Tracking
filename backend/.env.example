PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/divine-frames
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Optional. If left blank, uploaded photos are stored as base64 directly in
# MongoDB (works, just less efficient). Fill these in to store photos on
# Cloudinary instead — get them from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
